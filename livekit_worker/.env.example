# Copy to livekit_worker/.env.local or backend/.env
API_BASE_URL=http://localhost:8000
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=citizen-health-ai

# LiveKit Cloud inference (STT/LLM/TTS) — set in LiveKit Cloud dashboard or here
# LIVEKIT_STT_MODEL=deepgram/nova-3
# LIVEKIT_LLM_MODEL=openai/gpt-4o-mini
# LIVEKIT_TTS_MODEL=cartesia/sonic-2
